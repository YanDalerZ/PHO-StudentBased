# Frontend Environment Variables Template

# Backend Express API Base URL
VITE_API_URL=http://localhost:3000/api

# Cloudinary Direct Image Upload Configuration
# Register free tier account at https://cloudinary.com
# Create an unsigned upload preset (e.g. named "pho_student_photos")
# Preset Configuration Guidelines:
#   - Signing Mode: Unsigned
#   - Folder: pho_student_photos
#   - Allowed Formats: jpg, png, webp
#   - Max File Size: 5000000 (5MB)
#   - Transformations: (Optional) auto-orient, limit max dimensions
VITE_CLOUDINARY_CLOUD_NAME=lajydhvy
VITE_CLOUDINARY_UPLOAD_PRESET=pho_student_photos

VITE_API_URL=/api/v1
# Browser-side student photo uploads. Set both in the frontend build environment.
# Use a Cloudinary unsigned upload preset; never put an API secret in a VITE_ variable.
VITE_CLOUDINARY_CLOUD_NAME=<cloud-name>
VITE_CLOUDINARY_UPLOAD_PRESET=<unsigned-upload-preset>
# Public registration content and host policy are supplied by the backend.

PORT=3000
NODE_ENV=development

# Local development connects directly to the shared Aiven PostgreSQL service.
# Copy the current value from the team's private secret store; never commit it.
DATABASE_URL=postgres://avnadmin:AVNS_8Nf18KtgZHy-sADwjCj@pg-12fe6461-phoaklan.h.aivencloud.com:18205/defaultdb?
JWT_SECRET=<local-development-secret>
VITE_CLOUDINARY_CLOUD_NAME=<cloud-name>
VITE_CLOUDINARY_UPLOAD_PRESET=<upload-preset>

# Render uses one reverse-proxy hop. Keep 0 or omit for direct local development.
TRUST_PROXY_HOPS=0

# Required in production. Point this to a mounted private persistent volume,
# for example /var/data/report-exports when the Render disk is mounted at /var/data.
REPORT_EXPORT_STORAGE_ROOT=<persistent-private-directory>

# Required to enable QR invitation creation and public intake. Production origin
# must be HTTPS and must be the owner-approved public frontend host.
PUBLIC_REGISTRATION_ORIGIN=http://localhost:5173
PUBLIC_REGISTRATION_RATE_WINDOW_MS=<owner-approved-window-ms>
PUBLIC_REGISTRATION_RATE_LIMIT_PER_IP=<owner-approved-attempts-per-window>
PUBLIC_REGISTRATION_RATE_LIMIT_PER_INVITATION=<owner-approved-attempts-per-window>
PUBLIC_REGISTRATION_MAX_BODY_BYTES=<owner-approved-byte-limit-up-to-262144>
PUBLIC_REGISTRATION_PRIVACY_NOTICE=<owner-approved-data-use-and-consent-text>
PUBLIC_REGISTRATION_RETENTION_NOTICE=<owner-approved-pending-and-rejected-retention-text>
PUBLIC_REGISTRATION_CONTACT=<owner-approved-PHO-contact>

# Optional alternative to backend/src/database/ca.pem.
# DB_CA_CERT="-----BEGIN CERTIFICATE-----..."

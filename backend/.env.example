# Backend Environment Variables Template

PORT=3000

# Local development database. Never point this at the production `defaultdb`.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/pho_dev

# Use a long random value locally and a separately managed secret in Render.
JWT_SECRET=replace_with_a_long_random_secret

# Automated tests use an isolated database that the test runner may reset.
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/pho_test
TEST_DATABASE_SSL=false

# Required only when intentionally running the destructive init_db.ts helper.
ALLOW_DATABASE_RESET=false

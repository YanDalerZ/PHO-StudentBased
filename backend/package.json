  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive:true, force:true})\" && tsc",
    "start": "node dist/src/server.js",
    "go": "concurrently \"npm run dev\" \"cd ../frontend && npm run dev\"",
    "render-build": "npm install && npm run build && cd ../frontend && npm install && npm run build"
  },
